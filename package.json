    "check:bundle": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.5",
    "@types/node": "^22.10.1"
  },
  "engines": {
    "node": ">=20.19.0 <23",
    "npm": ">=10"
  }

  "version": "4.0.0-rc.19",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty -p tsconfig.app.json && tsc --noEmit --pretty -p tsconfig.node.json",
